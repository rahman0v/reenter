# Environment Configuration
NODE_ENV=development  # change to 'production' for production environment

# Server Configuration
PORT=5000

# Security
JWT_SECRET=your_secret_key_here  # IMPORTANT: Change this to a secure random string in production!

# Database Configuration - Development
DB_USER=postgres
DB_PASSWORD=rahmanov02  # Change this to your local PostgreSQL password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reenter_db

# Database Configuration - Production (uncomment and set when deploying)
# DB_USER=production_username
# DB_PASSWORD=secure_production_password
# DB_HOST=production_host
# DB_PORT=5432
# DB_NAME=reenter_db
# DB_SSL=true
# DB_POOL_MAX=20
# DB_IDLE_TIMEOUT=30000
# DB_CONNECTION_TIMEOUT=5000

# Frontend URL (for CORS configuration in production)
# FRONTEND_URL=https://yourdomain.com

# Seed Data Control (Development Only)
# FORCE_SEED=true  # Only set this if you need to run seed in production (not recommended) 